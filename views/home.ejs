<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>show post</title>
    <link rel="stylesheet" href="/css/home.css">
</head>
<body>

    <div class="container">

        <div class="post-card">

            <h1>Post Details</h1>

            <div class="detail-box">
                <span>ID</span>
                <p><%= post._id %></p>
            </div>

            <div class="detail-box">
                <span>Username</span>
                <p><%= post.username %></p>
            </div>

            <div class="detail-box">
                <span>Content</span>
                <p><%= post.content %></p>
            </div>

            <div class="detail-box">
                <span>Likes</span>
                <p>❤️ <%= post.likes %></p>
            </div>

            <a href="/posts" class="back-btn">
                ← Back To Posts
            </a>

        </div>

    </div>

</body>
</html>